# Copy this to .env and fill in your values

# --- Backend (server.js) ---

# Optional: enables live AI chat via Google Gemini. Without this, /api/chat
# automatically falls back to hardcoded pressure-tested responses.
GEMINI_API_KEY=your-gemini-key-here

# Optional: enables AI-written debrief reports via Groq (Llama 3). Without
# this, /api/debrief automatically falls back to a heuristic-scored report.
GROQ_API_KEY=your-groq-key-here

# Optional: Port for the Express server (default: 3001)
PORT=3001

# --- Frontend (Vite — must be prefixed VITE_ to be exposed to the browser) ---

# Required: where the frontend sends API requests. Use http://localhost:3001
# for local dev against the Express server above.
VITE_API_URL=http://localhost:3001

# Optional: enables login and session history via Supabase. Without these,
# auth/history features are disabled but scenarios still work.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
